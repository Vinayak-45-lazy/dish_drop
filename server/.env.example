# ===================================================
# DISHDROP SERVER — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your values
# ===================================================

# ===== SERVER =====
PORT=5000
NODE_ENV=development

# ===================================================
# FIREBASE ADMIN SDK
# Get from: Firebase Console → Project Settings →
# Service Accounts → Generate New Private Key
# ===================================================
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=your_client_email_here
FIREBASE_PRIVATE_KEY=your_private_key_here

# ===================================================
# GROQ AI API
# Get from: https://console.groq.com
# Free tier — no credit card needed
# ===================================================
GROQ_API_KEY=your_groq_api_key_here

# ===================================================
# CLOUDINARY (Free Tier)
# Get from: https://cloudinary.com/console
# ===================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_secret_here

# ===================================================
# RAZORPAY (Test Mode — Free)
# Get from: https://dashboard.razorpay.com/
# Use Test Mode keys only
# Test Card: 4111 1111 1111 1111 | Any future date | CVV: 123
# ===================================================
RAZORPAY_KEY_ID=your_razorpay_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ===================================================
# EMAIL — Gmail SMTP (Free)
# Steps:
# 1. Enable 2FA on your Gmail account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate a 16-character app password
# ===================================================
EMAIL_USER=your_email_here
EMAIL_PASS=your_email_password_here

# ===================================================
# ADMIN
# This email receives flag alerts and broadcast emails
# ===================================================
ADMIN_EMAIL=your_admin_email_here

# ===================================================
# JWT SECRET
# Use a long random string (min 32 characters)
# Generate one at: https://generate-secret.vercel.app/64
# ===================================================
JWT_SECRET=your_jwt_secret_here

# ===================================================
# CLIENT ENV VARIABLES (for reference)
# These go in client/.env — NOT here
# ===================================================
# REACT_APP_API_URL=http://localhost:5000
# REACT_APP_FIREBASE_API_KEY=from_firebase_console
# REACT_APP_FIREBASE_AUTH_DOMAIN=dishdrop.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=dishdrop
# REACT_APP_FIREBASE_STORAGE_BUCKET=dishdrop.appspot.com
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=from_firebase_console
# REACT_APP_FIREBASE_APP_ID=from_firebase_console
# REACT_APP_RAZORPAY_KEY_ID=your_razorpay_test_key_id